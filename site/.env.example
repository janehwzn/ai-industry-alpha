# Copy to .env for local dev. In production these are GitHub Actions secrets
# (VITE_*) and Supabase project settings / edge-function secrets.

# Supabase (required for login + newsletter signup + paid memberships)
VITE_SUPABASE_URL=https://xyzcompany.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Stripe price IDs (required for paid checkout; from Stripe Dashboard > Products)
VITE_STRIPE_PRICE_MONTHLY=price_...
VITE_STRIPE_PRICE_ANNUAL=price_...

# --- Supabase Edge Function secrets (set via `supabase secrets set`) ---
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# SITE_URL=https://aialpha.news   (or the GitHub Pages URL during testing)

# --- GitHub Actions secrets (repo Settings > Secrets > Actions) ---
# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY  (syncs newsletter signups into subscribers.txt)
# VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY / VITE_STRIPE_PRICE_MONTHLY / VITE_STRIPE_PRICE_ANNUAL
